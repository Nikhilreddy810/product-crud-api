# Copy this file to .env and replace every placeholder before starting the stack.
# Never commit .env or reuse these example values in a real deployment.
APP_PORT=8080
DB_NAME=productdb
DB_USER=product_api
DB_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
SEED_USER_USER=user
SEED_USER_PASSWORD=REPLACE_WITH_A_STRONG_USER_PASSWORD
